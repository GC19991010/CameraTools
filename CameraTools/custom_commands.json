  {
    "name": "系统调试",
    "description": "常用系统调试开关",
    "type": "command",
    "options": [
      {
        "name": "跳过开机引导",
        "commands": [
          "adb root",
          "adb remount",
          "adb wait-for-device",
          "adb root",
          "adb disable-verity",
          "adb shell settings put secure user_setup_complete 1",
          "adb shell settings put global device_provisioned 1",
          "adb shell settings put global miui_permission_check 3",
          "adb shell setprop persist.sys.uncheck_privapp_permission true",
          "adb shell pm disable com.xiaomi.account",
          "adb reboot"
        ]
      },
      {
        "name": "开启屏显",
        "commands": [
          "adb root",
          "adb remount"
        ]
      },
      {
        "name": "开启MTK LOGD",
        "commands": [
          "adb root",
          "adb remount",
          "adb shell setprop persist.vendor.mtk.camera.log_level 3"
        ]
      }
    ]
  }
]